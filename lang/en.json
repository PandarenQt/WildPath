        "Hint": "An optional rule from Baldur's Gate 3. On: Shove (to knock Prone or push 5 feet) costs a Bonus Action instead of an Action. Off: it takes an Action, as in the 2024 rules."
      },
      "HighGround": {
        "Name": "High ground (Baldur's Gate 3)",
        "Hint": "An optional rule from Baldur's Gate 3. On: an attack from 8 feet or more above its target gets +2 to its attack roll, and one from 8 feet or more below gets -2. Off: height gives no bonus, as in the 2024 rules."
      },
      "BatchSaves": {
        "Name": "Several saves at once",
        "Hint": "When you roll saves for several creatures at once (a Fireball on your monsters): one window to type some and roll the rest, or every save rolled for you. One save is asked for on its own.",
        "Physical": "One window, with physical dice",
        "Always": "Always one window",
        "Never": "Roll them all for me"
      },
      "InspirationMonsterRerolls": {
        "Name": "GM may reroll monster rolls with players' inspiration",
        "Hint": "On: after a monster's d20 (an attack, a save or a check), the GM is asked whether to reroll it by spending a player character's Heroic Inspiration point. Off: only players spend their points, on their own failed rolls."
      },
      "RollHitPoints": {
        "Name": "Roll hit points on level up",
        "Hint": "On: each level after the first rolls its Hit Die for hit points (at least 1, with the Fortitude modifier). Off: the Hit Die's average rounded up, as the 2024 rules suggest."
      },
      "PlayersSeeOdds": {
        "Name": "Players see the odds",
        "Hint": "House rule. On: before acting, players see the chance to hit and the chance a target fails its save, which reveals targets' AC and save bonuses. Off: only the GM sees them, except against a creature whose defenses an effect has revealed to the player's creature."
      },
