      "_id": "mmLoathsomeLimbs",
      "_key": "!actors.items!mmTroll000000000.mmLoathsomeLimbs",
      "name": "Loathsome Limbs",
      "type": "action",
      "img": "icons/magic/death/hand-withered-gray.webp",
      "system": {
        "active": true,
        "description": "<p class=\"feature\">If the troll ends any turn Bloodied and took 15+ Slashing damage during that turn, one of the trolll's limbs is severed, falls into the troll's space, and becomes a <strong>Troll Limb</strong>. The limb acts immediately after the troll's turn. The troll has 1 Exhaustion level for each missing limb, and it grows replacement limbs the next time it regains Hit Points.</p><section class=\"secret\" id=\"secret-01PBOuaZ8xS1KYt6\"><p><strong>Foundry Note</strong></p><p>This feature provides an <strong>Active Effect</strong> condition in the character sheet's Effects tab to enable each level of Exhaustion. Since the condition can be applied multiple times, the GM must manually manage the level of Exhaustion. There is an active effect available for each level of exhaustion.</p></section>",
        "definition": {
          "schemaVersion": 1,
          "id": "action:srd-loathsome-limbs-troll-limb",
          "costs": {
            "allOf": [
              {
                "capability": "action",
                "amount": 1
              }
            ]
          },
          "label": "Loathsome Limbs"
        },
