    {
      "_id": "mmBerserk0000000",
      "_key": "!actors.items!mmFleshGolem0000.mmBerserk0000000",
      "name": "Berserk",
      "type": "feature",
      "img": "icons/magic/movement/abstract-ribbons-red-orange.webp",
      "system": {
        "active": true,
        "description": "<p>Whenever the flesh golem starts its turn Bloodied, roll 1d6. On a 6, the flesh golem goes berserk. On each of its turns while berserk, the flesh golem attacks the nearest creature it can see. If no creature is near enough to move to and attack, the flesh golem attacks an object. Once the flesh golem goes berserk, it remains so until it is destroyed or it is no longer Bloodied.</p><p>The flesh golem's creator, if within 60 feet of the berserk flesh golem, can try to calm it by taking an action to make a DC @abilities.str.dc Charisma (Persuasion) check DC 15 Charisma (Persuasion) check; the golem must be able to hear its creator. If this check succeeds, the golem ceases being berserk until the start of its next turn, at which point it resumes rolling for the Berserk trait again if it is still Bloodied.</p>",
        "ruleElements": []
      },
      "flags": {
        "wildpath": {
          "source": {
            "system": "dnd5e",
            "pack": "actors24",
            "id": "mmBerserk0000000",
            "type": "feat",
            "book": "SRD 5.2",
            "license": "CC-BY-4.0",
            "rules": "2024"
          },
          "conversion": {
            "notes": [
              "\"Berserk Check\" is passive or triggered: not automated",
              "\"Calm Check\" is passive or triggered: not automated"
            ]
          }
        }
      }
