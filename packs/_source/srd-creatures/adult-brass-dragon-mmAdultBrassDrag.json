    {
      "_id": "q86q6o9mlcp60000",
      "_key": "!actors.items!mmAdultBrassDrag.q86q6o9mlcp60000",
      "name": "Detect Thoughts",
      "type": "action",
      "img": "icons/skills/social/diplomacy-handshake-yellow.webp",
      "system": {
        "active": true,
        "description": "<p>You activate one of the effects below. Until the spell ends, you can activate either effect as a Magic action on your later turns.</p><p><strong>Sense Thoughts.</strong> You sense the presence of thoughts within 30 feet of yourself that belong to creatures that know languages or are telepathic. You don't read the thoughts, but you know that a thinking creature is present.</p><p>The spell is blocked by 1 foot of stone, dirt, or wood; 1 inch of metal; or a thin sheet of lead.</p><p><strong>Read Thoughts.</strong> Target one creature you can see within 30 feet of yourself or one creature within 30 feet of yourself that you detected with the Sense Thoughts option. You learn what is most on the target's mind right now. If the target doesn't know any languages and isn't telepathic, you learn nothing.</p><p>As a Magic action on your next turn, you can try to probe deeper into the target's mind. If you probe deeper, the target makes a Wisdom saving throw. On a failed save, you discern the target's reasoning, emotions, and something that looms large in its mind (such as a worry, love, or hate). On a successful save, the spell ends. Either way, the target knows that you are probing into its mind, and until you shift your attention away from the target's mind, the target can take an action on its turn to make an DC @attributes.spell.dc Intelligence (Arcana) check check against your spell save DC, ending the spell on a success.</p>",
        "definition": {
          "schemaVersion": 1,
          "id": "action:srd-spellcasting-detect-thoughts",
          "tags": [
            "spell"
          ],
          "costs": {
            "allOf": [
              {
                "capability": "action",
                "amount": 1
              },
              {
                "capability": "spellcasting-phbspldetectthou",
                "amount": 1
              }
            ]
          },
          "label": "Detect Thoughts"
        },
        "ruleElements": [
          {
            "schemaVersion": 1,
            "id": "spellcasting-phbspldetectthou-uses",
            "type": "GrantResource",
            "data": {
              "resourceId": "spellcasting-phbspldetectthou",
              "label": "Spellcasting (Detect Thoughts)",
              "maximum": {
                "type": "constant",
                "value": 1
              },
              "recovery": "longRest"
            }
          }
        ]
      },
      "flags": {
        "wildpath": {
          "source": {
            "system": "dnd5e",
            "pack": "actors24",
            "id": "phbsplDetectThou",
            "type": "spell",
            "book": "SRD 5.2",
