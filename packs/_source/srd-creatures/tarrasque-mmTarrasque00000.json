            "dc": {
              "value": 27
            }
          },
          "effects": [
            {
              "id": "effect-1",
              "type": "condition",
              "conditionId": "blinded",
              "saveOutcomePolicy": "failure"
            },
            {
              "id": "effect-2",
              "type": "condition",
              "conditionId": "restrained",
              "saveOutcomePolicy": "failure"
            }
          ],
          "label": "Swallow (Save)"
        },
        "ruleElements": []
