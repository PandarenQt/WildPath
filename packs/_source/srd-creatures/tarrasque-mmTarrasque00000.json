    {
      "_id": "mmSwallow0000000",
      "_key": "!actors.items!mmTarrasque00000.mmSwallow0000000",
      "name": "Swallow (Save)",
      "type": "action",
      "img": "icons/creatures/abilities/mouth-teeth-rows-needles-purple.webp",
      "system": {
        "active": true,
        "description": "<p class=\"feature\"><em>Strength Saving Throw:</em> DC 27, one Large or smaller creature Grappled by the tarrasque (it can have up to six creatures swallowed at a time).</p><p class=\"feature\"><em>Failure:</em> The target is swallowed, and the Grappled condition ends. A swallowed creature has the Blinded and Restrained conditions and can't teleport, it has Total against attacks and other effects outside the tarrasque, and takes 56 (16d6) Acid damage at the start of each of the tarrasque's turns.</p><p class=\"feature\">If the tarrasque takes 60 damage or more on a single turn from a creature inside it, the tarrasque must succeed on a DC 20 Constitution saving throw at the end of that turn or regurgitate all swallowed creatures, each of which falls in a space within 10 feet of the tarrasque and has the Prone condition. If the tarrasque dies, any swallowed creature no longer has the Restrained condition and can escape from the corpse by using 20 feet of movement, exiting Prone.</p>",
        "definition": {
          "schemaVersion": 1,
          "id": "action:srd-swallow-save",
          "costs": {
            "allOf": [
              {
                "capability": "bonus-action",
                "amount": 1
              }
            ]
          },
          "range": {
            "type": "self"
          },
          "targeting": {
            "type": "self"
          },
          "save": {
