    {
      "_id": "mmCorrosiveForm0",
      "_key": "!actors.items!mmGrayOoze000000.mmCorrosiveForm0",
      "name": "Corrosive Form",
      "type": "feature",
      "img": "icons/skills/melee/sword-damaged-broken-purple.webp",
      "system": {
        "active": true,
        "description": "<p class=\"feature\">Nonmagical ammunition is destroyed immediately after hitting the gray ooze and dealing any damage. Any nonmagical weapon takes a cumulative −1 penalty to attack rolls immediately after dealing damage to the gray ooze and coming into contact with it. The weapon is destroyed if the penalty reaches −5. The penalty can be removed by casting the <em>Mending</em> spell on the weapon.</p><p class=\"feature\">The gray ooze can eat through 2-inch-thick, nonmagical metal or wood in 1 round.</p><section class=\"secret\" id=\"secret-NtgKYdQoCuiAaxOa\"><p><strong>Foundry Note</strong></p><p>This feature provides an <strong>Attack Penalty</strong> active effect that will modify a targeted weapon. Since this penalty can be applied multiple times to multiple nonmagical weapons, this active effect needs to be dragged from this item's Effect tab onto the target Item's weapons.</p></section>",
        "ruleElements": []
      },
