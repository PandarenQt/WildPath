    {
      "_id": "mmEngulf00000000",
      "_key": "!actors.items!mmGelatinousCube.mmEngulf00000000",
      "name": "Engulf (Save)",
      "type": "action",
      "img": "icons/creatures/slimes/slime-face-skull-green.webp",
      "system": {
        "active": true,
        "description": "<p class=\"feature\">The gelatinous cube moves up to its Speed without provoking Opportunity Attacks. The gelatinous cube can move through the spaces of Large or smaller creatures if it has room inside itself to contain them (see the Ooze Cube trait).</p><p class=\"feature\"><em>Dexterity Saving Throw:</em> DC 12, each creature whose space the gelatinous cube enters for the first time during this move.</p><p class=\"feature\"><em>Failure:</em> 10 (3d6) Acid damage, and the target is engulfed. An engulfed target is Suffocating, can't cast spells with a Verbal component, has the Restrained condition, and takes 10 (3d6) Acid damage at the start of each of the gelatinous cube's turns. When the gelatinous cube moves, the engulfed target moves with it. An engulfed target can try to escape by taking an action to make a DC @abilities.str.dc Strength (Athletics) check check. On a successful check, the target escapes and enters the nearest unoccupied space.</p><p class=\"feature\"><em>Success:</em> Half damage, and the target moves to an unoccupied space within 5 feet of the gelatinous cube's. If there is no unoccupied space, the target fails the save instead.</p>",
        "definition": {
          "schemaVersion": 1,
          "id": "action:srd-engulf-save",
