    {
      "_id": "mmOozeCube000000",
      "_key": "!actors.items!mmGelatinousCube.mmOozeCube000000",
      "name": "Ooze Cube",
      "type": "feature",
      "img": "icons/commodities/materials/glass-cube.webp",
      "system": {
        "active": true,
        "description": "<p class=\"feature\">The gelatinous cube fills its entire space and is transparent. Other creatures can enter that space, but a creature that does so is subjected to the gelatinous cube's Engulf and has Disadvantage on the saving throw.</p><p class=\"feature\">Creatures inside the gelatinous cube have Total, and the gelatinous cube can hold one Large creature or up to four Medium or Small creatures inside itself at a time.</p><p class=\"feature\">As an action, a creature within 5 ft. of the gelatinous cube can pull a creature or an object out of the gelatinous cube by succeeding on a DC 12 Strength (Athletics) check, and the puller takes 10 (3d6) Acid damage.</p>",
        "ruleElements": []
      },
      "flags": {
        "wildpath": {
          "source": {
