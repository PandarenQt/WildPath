    {
      "_id": "mmWhelm000000000",
      "_key": "!actors.items!mmWaterElemental.mmWhelm000000000",
      "name": "Whelm (Save)",
      "type": "action",
      "img": "icons/magic/water/bubbles-air-water-light.webp",
      "system": {
        "active": true,
        "description": "<p class=\"feature\"><em>Strength Saving Throw:</em> DC 15, each creature in the water elemental's space.</p><p class=\"feature\"><em>Failure:</em> 22 (4d8 + 4) Bludgeoning damage. If the target is a Large or smaller creature, it has the Grappled condition (escape DC ). Until the grapple ends, the target has the Restrained condition, is suffocating unless it can breathe water, and takes 9 (2d8) Bludgeoning damage at the start of each of the water elemental's turns. The water elemental can grapple one Large creature or up to two Medium or smaller creatures at a time with Whelm.</p><p class=\"feature\">As an action, a creature within 5 feet of the water elemental can pull a creature out of it by succeeding on a DC @skills.ath.passive (Athletics) check.</p><p class=\"feature\"><em>Success:</em> Half damage only.</p>",
        "definition": {
          "schemaVersion": 1,
          "id": "action:srd-whelm-save",
          "costs": {
            "allOf": [
              {
                "capability": "action",
                "amount": 1
              },
