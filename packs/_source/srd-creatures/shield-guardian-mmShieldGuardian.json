    {
      "_id": "mmSpellStoring00",
      "_key": "!actors.items!mmShieldGuardian.mmSpellStoring00",
      "name": "Spell Storing",
      "type": "feature",
      "img": "icons/magic/light/orb-container-orange.webp",
      "system": {
        "active": true,
        "description": "<p class=\"feature\">A spellcaster who wears the shield guardian's amulet can cause the shield guardian to store one spell of level 4 or lower. To do so, the wearer must cast the spell on the shield guardian while within 5 feet of it. The spell has no effect but is stored within the shield guardian. Any previously stored spell is lost when a new spell is stored. The shield guardian can cast the spell stored with any parameters set by the original caster, requiring no spell components and using the caster's spellcasting ability. The stored spell is then lost.</p>",
        "ruleElements": []
      },
