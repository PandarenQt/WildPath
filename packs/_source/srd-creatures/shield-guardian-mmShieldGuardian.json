    {
      "_id": "mmBound000000000",
      "_key": "!actors.items!mmShieldGuardian.mmBound000000000",
      "name": "Bound",
      "type": "feature",
      "img": "icons/creatures/magical/humanoid-silhouette-glowing-pink.webp",
      "system": {
        "active": true,
        "description": "<p>The shield guardian is magically bound to an amulet. While the shield guardian and its amulet are on the same plane of existence, the amulet's wearer can telepathically call the shield guardian to travel to it, and the shield guardian knows the distance and direction to the amulet. If the shield guardian is within 60 feet of the amulet's wearer, half of any damage the wearer takes (round up) is transferred to the shield guardian.</p>",
        "ruleElements": []
      },
      "flags": {
        "wildpath": {
          "source": {
