    {
      "_id": "mmVampireWeaknes",
      "_key": "!actors.items!mmVampireSpawn00.mmVampireWeaknes",
      "name": "Vampire Weakness",
      "type": "feature",
      "img": "icons/sundries/survival/stake-rough-heavy-brown.webp",
      "system": {
        "active": true,
        "description": "<p class=\"feature\">The vampire spawn has these weaknesses:</p><p class=\"feature-trait\"><strong>Forbiddance.</strong> The vampire spawn can't enter a residence without an invitation from an occupant.</p><p class=\"feature-trait\"><strong>Running Water.</strong> The vampire spawn takes 20 Acid damage if it ends its turn in running water.</p><p class=\"feature-trait\"><strong>Stake to the Heart.</strong> The vampire spawn is destroyed if a weapon that deals Piercing damage is driven into the vampire spawn's heart while the vampire spawn has the Incapacitated condition.</p><p class=\"feature-trait\"><strong>Sunlight.</strong> The vampire spawn takes 20 Radiant damage if it starts its turn in sunlight. While in sunlight, it has Disadvantage on attack rolls and ability checks.</p>",
        "ruleElements": []
      },
