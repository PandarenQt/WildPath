      "name": "Draconic Origin",
      "type": "feature",
      "img": "icons/creatures/abilities/dragon-breath-purple.webp",
      "system": {
        "active": true,
        "description": "<p class=\"feature\">The half-dragon is related to a type of dragon associated with one of the following damage types (DM's choice): Acid, Cold, Fire, Lightning, or Poison. This choice affects other aspects of the stat block.</p><section class=\"secret\" id=\"secret-9qS4XvlccQjIsypM\"><p><strong>Foundry Note</strong></p><p>This feature provides an Active Effect to manage <strong>Damage Resistances</strong> in the character sheet's Effects tab. The resistances outlined will need to be manually enabled/disabled.</p></section>",
        "ruleElements": []
      },
