      "name": "Gibbering",
      "type": "feature",
      "img": "icons/creatures/slimes/slime-face-teeth-purple.webp",
      "system": {
        "active": true,
        "description": "<p class=\"feature\">The gibbering mouther babbles incoherently while it doesn't have the Incapacitated condition.</p><p><em>Wisdom Saving Throw:</em> DC 10, any creature that starts its turn within 20 feet of the gibbering mouther while it is babbling.</p><p><em>Failure:</em> The target rolls 1d8 to determine what it does during the current turn:</p><p class=\"feature-trait\"><strong>1–4.</strong> The target does nothing.</p><p class=\"feature-trait\"><strong>5–6.</strong> The target takes no action or Bonus Action and uses all its movement to move in a random direction.</p><p class=\"feature-trait\"><strong>7–8.</strong> The target makes a melee attack against a randomly determined creature within its reach or does nothing if it can't make such an attack.</p>",
        "ruleElements": []
      },
      "flags": {
