<div class="wildpath-combat-carousel">
  {{#if shown}}
    <span class="carousel-round">{{localize "WILDPATH.CAROUSEL.Round" round=round}}</span>
    <ol class="carousel-turns">
      {{#each turns as |turn|}}
        <li class="carousel-turn {{#if turn.active}}active{{/if}} {{#if turn.defeated}}defeated{{/if}} {{#if turn.hidden}}concealed{{/if}}"
            data-combatant-id="{{turn.id}}">
          <button type="button" data-action="pan" data-tooltip="{{turn.name}}" {{#if turn.active}}aria-current="true"{{/if}}>
          {{#if turn.img}}<img src="{{turn.img}}" alt="" width="48" height="48">{{/if}}
          <span class="turn-name">{{turn.name}}</span>
          {{#if turn.health}}
            <span class="turn-health" role="meter" aria-valuemin="0" aria-valuemax="{{turn.health.max}}" aria-valuenow="{{turn.health.value}}"
                  aria-label="{{localize "WILDPATH.SHEET.Health" value=turn.health.value max=turn.health.max}}"
                  data-tooltip="{{localize "WILDPATH.SHEET.Health" value=turn.health.value max=turn.health.max}}"><span style="width: {{turn.health.percent}}%"></span></span>
          {{/if}}
          {{#if turn.conditions.length}}
            <span class="turn-conditions">
              {{#each turn.conditions as |condition|}}
                <img src="{{condition.img}}" alt="{{localize condition.name}}" width="16" height="16"
                     data-tooltip="<strong>{{localize condition.name}}</strong>{{#if condition.summary}}<br>{{localize condition.summary}}{{/if}}{{#if condition.remaining}}<br>{{condition.remaining}}{{/if}}">
              {{/each}}
            </span>
          {{/if}}
          </button>
        </li>
      {{/each}}
    </ol>
    {{#if canAdvance}}
      <button type="button" class="carousel-next" data-action="next">{{localize "WILDPATH.CAROUSEL.EndTurn"}}</button>
    {{/if}}
  {{/if}}
</div>
