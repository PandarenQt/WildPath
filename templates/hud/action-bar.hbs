<div class="wildpath-action-bar">
  {{#if shown}}
    <header class="bar-header">
      {{#if img}}<img src="{{img}}" alt="{{name}}" width="32" height="32">{{/if}}
      <span class="bar-name">{{name}}</span>
      <span class="bar-conditions">
        {{#each conditions as |condition|}}
          <span class="bar-condition" data-tooltip="<strong>{{localize condition.name}}</strong>{{#if condition.summary}}<br>{{localize condition.summary}}{{/if}}{{#if condition.remaining}}<br>{{condition.remaining}}{{/if}}">
            <img src="{{condition.img}}" alt="{{localize condition.name}}" width="20" height="20">
            {{#if condition.level}}<span class="condition-level">{{condition.level}}</span>{{/if}}
          </span>
        {{/each}}
      </span>
    </header>
    <div class="bar-resources">
      {{#each resources as |resource|}}
        <span class="bar-resource {{#if resource.depleted}}depleted{{/if}}">{{resource.label}} {{resource.current}}/{{resource.maximum}}
          {{#if resource.policy}}
            <button type="button" class="bar-policy policy-{{resource.policy.id}}" data-action="reactionPolicy" data-item-id="{{resource.id}}"
                    data-tooltip="{{resource.policy.label}}" aria-label="{{localize resource.policy.label}}">
              <i class="fa-solid {{resource.policy.icon}}" inert></i></button>
          {{/if}}
        </span>
      {{/each}}
    </div>
    <div class="bar-groups">
      {{#each groups as |group|}}
        <div class="bar-group" data-group="{{group.id}}">
          <span class="bar-group-label">{{localize group.label}}</span>
          {{#each group.actions as |action|}}
            <button type="button" class="bar-action" data-action="use" data-item-id="{{action.id}}"
                    {{#unless action.enabled}}aria-disabled="true" data-tooltip="{{action.label}}<br>{{localize action.reason.key name=action.reason.name}}"{{else}}{{#if action.odds}}data-tooltip="{{action.label}}<br>{{action.odds.tooltip}}"{{else}}data-tooltip="{{action.label}}"{{/if}}{{/unless}}
                    aria-label="{{action.label}}">
              <img src="{{action.img}}" alt="" width="28" height="28">
              <span class="bar-action-label">{{action.label}}</span>
              {{#if action.odds}}<span class="bar-odds">{{action.odds.badge}}</span>{{/if}}
            </button>
            {{#if action.slots}}
              <span class="bar-slots">
                {{#each action.slots as |slot|}}
                  <button type="button" class="bar-slot" data-action="useSlot" data-item-id="{{action.id}}" data-choice-id="{{slot.choiceId}}"
                          data-option-id="{{slot.optionId}}" data-tooltip="{{slot.label}}" aria-label="{{action.label}}: {{slot.label}}">{{slot.level}}</button>
                {{/each}}
              </span>
            {{/if}}
            {{#if action.policy}}
              <button type="button" class="bar-policy policy-{{action.policy.id}}" data-action="reactionPolicy" data-item-id="{{action.id}}"
                      data-tooltip="{{action.policy.label}}" aria-label="{{localize action.policy.label}}">
                <i class="fa-solid {{action.policy.icon}}" inert></i></button>
            {{/if}}
          {{/each}}
        </div>
      {{else}}
        <span class="bar-empty">{{localize "WILDPATH.ACTIONBAR.NoActions"}}</span>
      {{/each}}
    </div>
  {{/if}}
</div>
