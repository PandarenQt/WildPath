<div class="wildpath chat-card resolution-card" data-resolution-id="{{resolutionId}}">
  {{#if actionName}}
  <header class="card-header">
    {{#if actionImg}}<img class="card-icon" src="{{actionImg}}" alt="">{{/if}}
    <h4 class="card-title">{{actionName}}</h4>
  </header>
  {{/if}}
  {{{rollHtml}}}
  {{#each enteredRolls}}
  <div class="dice-roll">
    <div class="dice-result">
      {{#if formula}}<div class="dice-formula">{{formula}}</div>{{/if}}
      <h4 class="dice-total">{{total}}</h4>
    </div>
  </div>
  {{/each}}
  {{#if targets.length}}
  <ul class="card-targets">
    {{#each targets}}
    <li class="card-target"{{#if uuid}} data-target-uuid="{{uuid}}" role="button" tabindex="0"{{/if}}>
      <span class="target-name">{{name}}</span>
      <span class="target-outcomes">
        {{#if attack}}<span class="outcome {{attack.tone}}">{{localize attack.label}}</span>{{/if}}
        {{#if save}}<span class="outcome {{save.tone}}">{{localize save.label}}</span>{{/if}}
      </span>
    </li>
    {{/each}}
  </ul>
  {{/if}}
</div>
