<div class="wildpath actor-sheet">

  <header class="sheet-header actor-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" alt="{{actor.name}}">

    <div class="actor-title">
      <input class="actor-name" type="text" name="name" value="{{header.name}}">
      <div class="actor-summary">
        <span class="actor-pill">{{localize typeLabel}}</span>
        {{#if header.health}}
          <span>{{localize "WILDPATH.SHEET.Health" value=header.health.value max=header.health.max}}</span>
          {{#if header.health.temp}}<span>{{localize "WILDPATH.SHEET.TempHealth" temp=header.health.temp}}</span>{{/if}}
        {{/if}}
        {{#if header.movement}}
          <span>{{localize "WILDPATH.SHEET.Move" distance=header.movement.value}}</span>
        {{/if}}
        {{#each header.speeds as |speed|}}
          <span>{{localize speed.label mode=speed.mode distance=speed.distance}}</span>
        {{/each}}
        {{#if header.ac}}<span title="{{localize "WILDPATH.SHEET.EffectiveAc"}}">{{localize "WILDPATH.SHEET.AC"}} {{header.ac}}</span>{{/if}}
        {{#if header.level}}<span>{{localize "WILDPATH.SHEET.Level"}} {{header.level}}</span>{{/if}}
        {{#if header.proficiency}}<span>{{localize "WILDPATH.SHEET.Proficiency" bonus=header.proficiency}}</span>{{/if}}
        {{#if header.threat}}<span>{{localize "WILDPATH.SHEET.Threat"}} {{header.threat}}</span>{{/if}}
        <span>{{localize "WILDPATH.SHEET.ActionCount" count=summary.actionCount}}</span>
        <span>{{localize "WILDPATH.SHEET.ConditionCount" count=summary.activeConditionCount}}</span>
      </div>
      <div class="actor-commands">
        <button type="button" data-action="rest" data-recovery="shortRest">{{localize "WILDPATH.SHEET.ShortRest"}}</button>
        <button type="button" data-action="rest" data-recovery="longRest">{{localize "WILDPATH.SHEET.LongRest"}}</button>
        {{#if canChooseAbilityScores}}
          <button type="button" data-action="abilityScores">{{localize "WILDPATH.ABILITYSCORES.Button"}}</button>
        {{/if}}
        {{#each levelUps as |entry|}}
          <button type="button" data-action="levelUp" data-item-id="{{entry.id}}">{{entry.label}}</button>
        {{/each}}
      </div>
    </div>
  </header>

  <nav class="sheet-nav" aria-label="{{localize "WILDPATH.SHEET.Sections"}}">
    {{#each sections as |section|}}
      <a href="#{{section.anchor}}">{{localize section.label}}</a>
    {{/each}}
  </nav>

  <div class="sheet-body">
    <section id="wildpath-{{actor.id}}-overview" class="sheet-section overview-section">
      <div class="section-heading">
        <h3>{{localize "WILDPATH.SHEET.Section.Overview"}}</h3>
      </div>

      <div class="overview-grid">
        <div class="field-block">
          <h4>{{localize "WILDPATH.SHEET.Abilities"}}</h4>
          <div class="ability-grid">
            {{#each abilities as |ability|}}
              <label class="ability">
                <span>{{localize ability.label}}{{#if ability.changed}} <span class="ability-effective"
                  data-tooltip="WILDPATH.SHEET.AbilityEffective">({{ability.effective}})</span>{{/if}}</span>
                <input type="number" name="system.abilities.{{ability.key}}.value" value="{{ability.value}}">
                <span class="ability-rolls">
                  <input type="checkbox" name="system.abilities.{{ability.key}}.saveProficient" {{checked ability.saveProficient}}
                         title="{{localize "WILDPATH.SHEET.SaveProficient"}}" aria-label="{{localize "WILDPATH.SHEET.SaveProficient"}}">
                  {{#if ability.saveGranted}}<i class="fa-solid fa-link granted" data-tooltip="WILDPATH.SHEET.GrantedSave"
                    aria-label="{{localize "WILDPATH.SHEET.GrantedSave"}}"></i>{{/if}}
                  <button type="button" class="icon-roll" data-action="rollTest" data-ability="{{ability.key}}"
                          title="{{localize "WILDPATH.SHEET.RollCheck"}}" aria-label="{{localize "WILDPATH.SHEET.RollCheck"}}"><i class="fa-solid fa-dice-d20"></i></button>
                  <button type="button" class="icon-roll" data-action="rollTest" data-save="{{ability.key}}"
                          title="{{localize "WILDPATH.SHEET.RollSave"}}" aria-label="{{localize "WILDPATH.SHEET.RollSave"}}"><i class="fa-solid fa-shield-halved"></i></button>
                </span>
              </label>
            {{/each}}
          </div>
        </div>

        <div class="field-block">
          <h4>{{localize "WILDPATH.SHEET.Resources"}}</h4>
          <div class="resource-grid">
            <label class="resource">
              <span class="label">{{localize "WILDPATH.SHEET.ArmorClass"}}</span>
              <span class="resource-values">
                <span class="max" title="{{localize "WILDPATH.SHEET.EffectiveAc"}}">{{header.ac}}</span>
                <input class="base" type="number" name="system.defenses.ac.value" value="{{header.baseAc}}" min="0"
                       placeholder="{{localize "WILDPATH.SHEET.AcCalculated"}}" title="{{localize "WILDPATH.SHEET.AcTyped"}}">
              </span>
            </label>
            {{#each resources as |resource|}}
              <label class="resource">
                <span class="label">{{localize resource.label}}</span>
                <span class="resource-values">
                  <input type="number" name="system.resources.{{resource.key}}.value" value="{{resource.value}}">
                  <span class="sep">/</span>
                  <span class="max">{{resource.max}}</span>
                  <input class="base" type="number" name="system.resources.{{resource.key}}.base" value="{{resource.base}}"
                         title="{{localize "WILDPATH.SHEET.Base"}}">
                </span>
              </label>
              {{#if resource.hasTemp}}
              <label class="resource">
                <span class="label">{{localize "WILDPATH.SHEET.TempHealthLabel"}}</span>
                <span class="resource-values">
                  <input type="number" name="system.resources.{{resource.key}}.temp" value="{{resource.temp}}" min="0">
                </span>
              </label>
              {{/if}}
            {{/each}}
            {{#each pools as |pool|}}
              <label class="resource pool">
                <span class="label">{{pool.label}}</span>
                <span class="resource-values">
                  <input type="number" name="system.pools.{{pool.index}}.value" value="{{pool.value}}">
                  <span class="sep">/</span>
                  <span class="max">{{pool.max}}</span>
                  <input class="base" type="number" name="system.pools.{{pool.index}}.base" value="{{pool.base}}"
                         title="{{localize "WILDPATH.SHEET.Base"}}">
                </span>
              </label>
            {{/each}}
          </div>
        </div>

        <div class="field-block skills-block">
          <h4>{{localize "WILDPATH.SHEET.Skills"}}</h4>
          <ol class="skill-list">
            {{#each skills as |skill|}}
              <li class="skill-row">
                <select name="system.skills.{{skill.key}}.proficiency" aria-label="{{localize skill.label}}: {{localize "WILDPATH.SHEET.SkillProficiency.Label"}}">
                  {{selectOptions @root.proficiencyLevels selected=skill.proficiency localize=true}}
                </select>
                <button type="button" class="skill-name" data-action="rollTest" data-skill="{{skill.key}}"
                        title="{{localize "WILDPATH.SHEET.RollSkill"}}">{{localize skill.label}} <span class="skill-ability">({{localize skill.abilityLabel}})</span></button>
                <span class="skill-modifier">{{skill.modifierText}}</span>
                {{#if skill.granted}}<span class="granted">{{localize "WILDPATH.SHEET.Granted" list=(localize skill.granted)}}</span>{{/if}}
              </li>
            {{/each}}
          </ol>
          <h4>{{localize "WILDPATH.SHEET.Training.Label"}}</h4>
          {{#each training as |entry|}}
            <label class="training">
              <span>{{localize entry.label}}</span>
              <input type="text" name="system.training.{{entry.key}}" value="{{entry.value}}" placeholder="{{localize entry.hint}}">
              {{#if entry.granted}}<span class="granted">{{localize "WILDPATH.SHEET.Granted" list=entry.granted}}</span>{{/if}}
            </label>
          {{/each}}
        </div>
      </div>

      <div class="field-block conditions-block">
        <h4>{{localize "WILDPATH.SHEET.Conditions"}}</h4>
        <div class="condition-list">
          {{#each conditions as |condition|}}
            <a class="condition {{#if condition.active}}active{{/if}}" data-action="toggleCondition"
               data-condition-id="{{condition.id}}" {{#if condition.stacking}}data-stacking{{/if}}
               title="{{localize condition.name}}{{#if condition.stacking}} — {{localize "WILDPATH.SHEET.StackingHint"}}{{/if}}">
              <img src="{{condition.img}}" width="28" height="28" alt="{{localize condition.name}}">
              {{#if condition.level}}<span class="condition-level">{{condition.level}}</span>{{/if}}
            </a>
          {{/each}}
        </div>
      </div>

      <div class="field-block dying-block">
        <h4>{{localize "WILDPATH.SHEET.DeathSaves"}}</h4>
        {{#if header.deathSaves}}
          <div class="death-saves">
            <span>{{localize "WILDPATH.SHEET.Successes"}}</span>
            {{#each header.deathSaves.successPips as |marked|}}<span class="pip {{#if marked}}marked{{/if}}"></span>{{/each}}
            <span>{{localize "WILDPATH.SHEET.Failures"}}</span>
            {{#each header.deathSaves.failurePips as |marked|}}<span class="pip failure {{#if marked}}marked{{/if}}"></span>{{/each}}
            {{#if header.deathSaves.stable}}<span class="actor-pill">{{localize "WILDPATH.SHEET.Stable"}}</span>{{/if}}
          </div>
        {{/if}}
        <label class="dying-mode">
          <span>{{localize "WILDPATH.SHEET.DyingModeLabel"}}</span>
          <select name="system.dyingMode">{{selectOptions dyingModes selected=header.dyingMode localize=true}}</select>
        </label>
      </div>
    </section>

    <section id="wildpath-{{actor.id}}-actions" class="sheet-section">
      <div class="section-heading">
        <h3>{{localize "WILDPATH.SHEET.Section.Actions"}}</h3>
        <span>{{summary.actionCount}}</span>
        {{#if preparedSpells}}
          <span class="prepared-count{{#if preparedSpells.over}} over-limit{{/if}}" title="{{localize "WILDPATH.SHEET.PreparedHint"}}">
            {{#if preparedSpells.limit}}{{localize "WILDPATH.SHEET.PreparedCount" count=preparedSpells.count limit=preparedSpells.limit}}{{else}}{{localize "WILDPATH.SHEET.PreparedOnly" count=preparedSpells.count}}{{/if}}
          </span>
        {{/if}}
        <button type="button" class="row-command" data-action="createItem" data-type="action">{{localize "WILDPATH.SHEET.Create"}}</button>
      </div>

      <ol class="sheet-list action-list">
        {{#each actionItems as |item|}}
          <li class="sheet-row action-row {{#unless item.availability.enabled}}unavailable{{/unless}}" data-item-id="{{item.id}}">
            <img class="row-image" src="{{item.img}}" width="32" height="32" alt="{{item.name}}">
            <div class="row-main">
              <a class="row-name" data-action="openItem">{{item.name}}</a>
              <span class="row-detail">{{item.availability.reason}}</span>
            </div>
            {{#if item.prepares}}
              <button type="button" class="row-command" data-action="togglePrepared" aria-pressed="{{#if item.prepared}}true{{else}}false{{/if}}">
                {{#if item.prepared}}{{localize "WILDPATH.SHEET.Prepared"}}{{else}}{{localize "WILDPATH.SHEET.NotPrepared"}}{{/if}}
              </button>
            {{/if}}
            <button type="button" class="row-command" data-action="useItem" {{#unless item.availability.enabled}}disabled{{/unless}}{{#if item.prepares}}{{#unless item.prepared}} disabled{{/unless}}{{/if}}>{{localize "WILDPATH.SHEET.Use"}}</button>
            <button type="button" class="row-command" data-action="deleteItem" title="{{localize "WILDPATH.SHEET.Delete"}}">✕</button>
          </li>
        {{else}}
          <li class="empty-row">{{localize "WILDPATH.SHEET.Empty.Actions"}}</li>
        {{/each}}
      </ol>
    </section>

    <section id="wildpath-{{actor.id}}-inventory" class="sheet-section">
      <div class="section-heading">
        <h3>{{localize "WILDPATH.SHEET.Section.Inventory"}}</h3>
        <span>{{summary.featureCount}} / {{summary.gearCount}}</span>
      </div>

      <div class="inventory-columns">
        <div class="field-block">
          <h4>{{localize "WILDPATH.SHEET.Features"}}
            <button type="button" class="row-command" data-action="createItem" data-type="feature">{{localize "WILDPATH.SHEET.Create"}}</button>
          </h4>
          <ol class="sheet-list">
            {{#each featureItems as |item|}}
              <li class="sheet-row" data-item-id="{{item.id}}">
                <img class="row-image" src="{{item.img}}" width="28" height="28" alt="{{item.name}}">
                <div class="row-main">
                  <a class="row-name" data-action="openItem">{{item.name}}</a>
                  <span class="row-detail">{{item.type}}</span>
                </div>
                <button type="button" class="row-command" data-action="deleteItem" title="{{localize "WILDPATH.SHEET.Delete"}}">✕</button>
              </li>
            {{else}}
              <li class="empty-row">{{localize "WILDPATH.SHEET.Empty.Features"}}</li>
            {{/each}}
          </ol>
        </div>

        <div class="field-block">
          <h4>{{localize "WILDPATH.SHEET.Gear"}}
            <span class="row-detail">{{localize "WILDPATH.SHEET.Carried" weight=summary.carriedWeight}}</span>
            <button type="button" class="row-command" data-action="createItem" data-type="gear">{{localize "WILDPATH.SHEET.Create"}}</button>
          </h4>
          <ol class="sheet-list">
            {{#each gearItems as |item|}}
              <li class="sheet-row gear-row {{#unless item.active}}unavailable{{/unless}}" data-item-id="{{item.id}}">
                <img class="row-image" src="{{item.img}}" width="28" height="28" alt="{{item.name}}">
                <div class="row-main">
                  <a class="row-name" data-action="openItem">{{item.name}}</a>
                  <span class="row-detail">{{localize "WILDPATH.SHEET.Weight" weight=item.weight}}</span>
                </div>
                <input class="quantity" type="number" min="0" step="1" value="{{item.quantity}}" data-item-field="system.quantity"
                       aria-label="{{localize "WILDPATH.SHEET.Quantity"}}" title="{{localize "WILDPATH.SHEET.Quantity"}}">
                <button type="button" class="row-command" data-action="toggleEquipped" aria-pressed="{{#if item.active}}true{{else}}false{{/if}}">
                  {{#if item.active}}{{localize "WILDPATH.SHEET.Equipped"}}{{else}}{{localize "WILDPATH.SHEET.Unequipped"}}{{/if}}
                </button>
                {{#if item.attunement}}
                  <button type="button" class="row-command" data-action="toggleAttuned" title="{{localize "WILDPATH.SHEET.AttunementHint"}}"
                          aria-pressed="{{#if item.attuned}}true{{else}}false{{/if}}">
                    {{#if item.attuned}}{{localize "WILDPATH.SHEET.Attuned"}}{{else}}{{localize "WILDPATH.SHEET.NotAttuned"}}{{/if}}
                  </button>
                {{/if}}
                <button type="button" class="row-command" data-action="deleteItem" title="{{localize "WILDPATH.SHEET.Delete"}}">✕</button>
              </li>
            {{else}}
              <li class="empty-row">{{localize "WILDPATH.SHEET.Empty.Gear"}}</li>
            {{/each}}
          </ol>
        </div>
      </div>

      <div class="field-block other-items">
        <h4>{{localize "WILDPATH.SHEET.Other"}}</h4>
        <ol class="sheet-list">
          {{#each otherItems as |item|}}
            <li class="sheet-row" data-item-id="{{item.id}}">
              <img class="row-image" src="{{item.img}}" width="28" height="28" alt="{{item.name}}">
              <div class="row-main">
                <a class="row-name" data-action="openItem">{{item.name}}</a>
                <span class="row-detail">{{item.type}}</span>
              </div>
              <button type="button" class="row-command" data-action="deleteItem" title="{{localize "WILDPATH.SHEET.Delete"}}">✕</button>
            </li>
          {{else}}
            <li class="empty-row">{{localize "WILDPATH.SHEET.Empty.Other"}}</li>
          {{/each}}
        </ol>
      </div>
    </section>

    <section id="wildpath-{{actor.id}}-effects" class="sheet-section">
      <div class="section-heading">
        <h3>{{localize "WILDPATH.SHEET.ActiveEffects"}}</h3>
        <span>{{summary.effectCount}}</span>
        <button type="button" class="row-command" data-action="createEffect">{{localize "WILDPATH.SHEET.Create"}}</button>
      </div>

      <ol class="sheet-list effect-list">
        {{#each effects as |effect|}}
          <li class="sheet-row effect-row {{#if effect.disabled}}unavailable{{/if}}" data-effect-id="{{effect.id}}">
            <img class="row-image" src="{{effect.img}}" width="28" height="28" alt="{{effect.name}}">
            <a class="row-name" data-action="openEffect">{{effect.name}}</a>
            <button type="button" class="row-command" data-action="toggleEffect">
              {{#if effect.disabled}}{{localize "WILDPATH.SHEET.Enable"}}{{else}}{{localize "WILDPATH.SHEET.Disable"}}{{/if}}
            </button>
            <button type="button" class="row-command" data-action="deleteEffect" title="{{localize "WILDPATH.SHEET.Delete"}}">✕</button>
          </li>
        {{else}}
          <li class="empty-row">{{localize "WILDPATH.SHEET.Empty.Effects"}}</li>
        {{/each}}
      </ol>
    </section>

    <section id="wildpath-{{actor.id}}-biography" class="sheet-section biography">
      <div class="section-heading">
        <h3>{{localize "WILDPATH.SHEET.Section.Biography"}}</h3>
      </div>
      <div class="sheet-editor">
        {{editor system.biography target="system.biography" button=true engine="prosemirror"}}
      </div>
    </section>
  </div>

</div>
