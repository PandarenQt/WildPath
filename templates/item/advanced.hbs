<section class="tab advanced {{tab.cssClass}}" data-group="sheet" data-tab="advanced">

  {{#if isAction}}
  <section class="action-cost">
    <h3>{{localize "WILDPATH.ITEMSHEET.Cost"}}</h3>
    {{#each actionCostResources as |resource|}}
      <label class="cost">
        <span>{{localize resource.label}}</span>
        <input type="number" name="system.cost.{{resource.key}}" value="{{lookup ../system.cost resource.key}}">
      </label>
    {{/each}}
  </section>

  <section class="definition-editor">
    <h3>{{localize "WILDPATH.ITEMSHEET.Definition"}}</h3>
    <textarea name="wildpath.definitionJson" class="json-editor" rows="14" spellcheck="false">{{definitionJson}}</textarea>
    {{#if definitionErrors.length}}
      <ul class="json-errors">
        <li>{{localize "WILDPATH.ITEMSHEET.NotSaved"}}</li>
        {{#each definitionErrors as |error|}}<li>{{error}}</li>{{/each}}
      </ul>
    {{/if}}
  </section>
  {{/if}}

  <section class="rule-element-editor">
    <h3>{{localize "WILDPATH.ITEMSHEET.RuleElements"}}</h3>
    <textarea name="wildpath.ruleElementsJson" class="json-editor" rows="8" spellcheck="false">{{ruleElementsJson}}</textarea>
    {{#if ruleElementErrors.length}}
      <ul class="json-errors">
        <li>{{localize "WILDPATH.ITEMSHEET.NotSaved"}}</li>
        {{#each ruleElementErrors as |error|}}<li>{{error}}</li>{{/each}}
      </ul>
    {{/if}}
  </section>

  <section class="modifiers">
    <h3>{{localize "WILDPATH.ITEMSHEET.Modifiers"}}</h3>
    <ol class="modifier-list">
      {{#each modifiers as |modifier|}}
        <li class="modifier">
          <input type="text" name="system.modifiers.{{modifier.index}}.domains" value="{{modifier.domainsText}}"
                 placeholder="{{localize "WILDPATH.ITEMSHEET.DomainsPlaceholder"}}">
          <input type="text" name="system.modifiers.{{modifier.index}}.label" value="{{modifier.label}}"
                 placeholder="{{localize "WILDPATH.ITEMSHEET.LabelPlaceholder"}}">
          <input type="text" name="system.modifiers.{{modifier.index}}.type" value="{{modifier.type}}"
                 placeholder="{{localize "WILDPATH.ITEMSHEET.TypePlaceholder"}}">
          <input type="number" name="system.modifiers.{{modifier.index}}.value" value="{{modifier.value}}">
        </li>
      {{/each}}
    </ol>
  </section>

</section>
