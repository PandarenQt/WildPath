{{!-- One resolution's rolls, outcomes and changes: the Rules Inspector's detail and the item sheet's Test tab. --}}
{{#if selected.rolls.length}}
  <h4>{{localize "WILDPATH.INSPECTOR.Rolls"}}</h4>
  <table><tbody>
    {{#each selected.rolls as |roll|}}
      <tr><td>{{#if roll.kindType}}{{localize roll.kindLabel type=(localize roll.kindType)}}{{else if roll.kindLabel}}{{localize roll.kindLabel}}{{/if}}</td><td>{{roll.formula}}</td><td>{{#if roll.modeLabel}}{{localize roll.modeLabel}}{{/if}}</td><td>{{roll.natural}} → {{roll.total}}</td><td>{{#if roll.methodLabel}}{{localize roll.methodLabel}}{{/if}}</td></tr>
    {{/each}}
  </tbody></table>
{{/if}}
{{#if selected.attacks.length}}
  <h4>{{localize "WILDPATH.INSPECTOR.Attacks"}}</h4>
  <table><tbody>
    {{#each selected.attacks as |attack|}}
      <tr><td>{{attack.target}}</td><td>{{localize "WILDPATH.INSPECTOR.AgainstAC" total=attack.total defense=attack.defense}}</td><td>{{localize attack.outcomeLabel}}</td></tr>
    {{/each}}
  </tbody></table>
{{/if}}
{{#if selected.saves.length}}
  <h4>{{localize "WILDPATH.INSPECTOR.Saves"}}</h4>
  <table><tbody>
    {{#each selected.saves as |save|}}
      <tr><td>{{save.target}}</td><td>{{#if save.automatic}}{{localize "WILDPATH.INSPECTOR.Automatic"}}{{else}}{{save.total}}{{/if}} {{localize "WILDPATH.INSPECTOR.AgainstDC" dc=save.dc}}</td><td>{{localize save.outcomeLabel}}</td></tr>
    {{/each}}
  </tbody></table>
{{/if}}
{{#if selected.changes.length}}
  <h4>{{localize "WILDPATH.INSPECTOR.Changes"}}</h4>
  <table><tbody>
    {{#each selected.changes as |change|}}
      <tr><td>{{change.target}}</td><td>{{localize change.typeLabel}} {{change.amount}}</td><td>{{change.from}} → {{change.to}}</td></tr>
    {{/each}}
  </tbody></table>
{{/if}}
{{#if selected.effects.length}}
  <h4>{{localize "WILDPATH.INSPECTOR.Effects"}}</h4>
  <table><tbody>
    {{#each selected.effects as |effect|}}
      <tr><td>{{effect.target}}</td><td>{{localize effect.effect}}</td><td>{{#if effect.actionLabel}}{{localize effect.actionLabel}}{{/if}}</td></tr>
    {{/each}}
  </tbody></table>
{{/if}}
{{#if selected.payments.length}}
  <h4>{{localize "WILDPATH.INSPECTOR.Payments"}}</h4>
  <table><tbody>
    {{#each selected.payments as |payment|}}
      <tr><td>{{localize payment.payerLabel}}</td><td>{{localize payment.resourceLabel}}</td><td>{{payment.from}} → {{payment.to}}</td></tr>
    {{/each}}
  </tbody></table>
{{/if}}
{{#if selected.errors.length}}
  <h4>{{localize "WILDPATH.INSPECTOR.Errors"}}</h4>
  <ul>{{#each selected.errors as |error|}}<li>{{error}}</li>{{/each}}</ul>
{{/if}}
