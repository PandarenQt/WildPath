<div class="wildpath-inspector">
  <ol class="inspector-list">
    {{#each entries as |entry|}}
      <li class="inspector-entry {{#if entry.active}}active{{/if}}" data-action="select" data-resolution-id="{{entry.id}}">
        <span class="entry-label">{{entry.label}}</span>
        <span class="entry-status">{{entry.status}}</span>
      </li>
    {{else}}
      <li class="inspector-empty">{{localize "WILDPATH.INSPECTOR.Empty"}}</li>
    {{/each}}
  </ol>
  {{#if selected}}
    <section class="inspector-detail">
      <h3>{{selected.label}} <span class="entry-status">{{selected.status}}</span></h3>
      <p class="inspector-stages">{{#each selected.stages as |stage|}}<span>{{stage}}</span>{{/each}}</p>
      {{#if waiting.length}}
        <div class="inspector-waiting">
          <ul>{{#each waiting as |entry|}}<li>{{localize "WILDPATH.INSPECTOR.WaitingOn" user=entry.user type=entry.type}}</li>{{/each}}</ul>
          <button type="button" data-action="answer">{{localize "WILDPATH.INSPECTOR.AnswerFor"}}</button>
        </div>
      {{/if}}
      {{> "systems/wildpath/templates/apps/resolution-detail.hbs" selected=selected}}
    </section>
  {{/if}}
</div>
