<section class="refresh-items-body">
  <p class="hint">{{localize "WILDPATH.REFRESH.Hint"}}</p>
  {{#if count}}
  <ol class="refresh-items-list">
    {{#each entries as |entry|}}
    <li><strong>{{entry.name}}</strong>{{#if entry.owner}} ({{entry.owner}}){{/if}} <span class="hint">{{entry.parts}}</span></li>
    {{/each}}
  </ol>
  <button type="button" data-action="refresh"><i class="fa-solid fa-rotate" inert></i> {{localize "WILDPATH.REFRESH.Refresh" count=count}}</button>
  {{else}}
  <p>{{localize "WILDPATH.REFRESH.UpToDate"}}</p>
  {{/if}}
</section>
