<div class="bastion-map-body">
  <aside class="bastion-facilities">
    <p class="hint">{{localize "WILDPATH.BASTION.MapHint" size=size}}</p>
    <ol>
      {{#each facilities as |facility|}}
        <li>
          <button type="button" data-action="pick" data-facility-id="{{facility.id}}" class="{{#if facility.selected}}active{{/if}}"
            aria-pressed="{{#if facility.selected}}true{{else}}false{{/if}}">
            <span class="swatch" style="background: {{facility.color}}"></span>
            <span class="name">{{facility.name}}</span>
            <span class="count">{{facility.used}} / {{facility.most}} ({{facility.size}})</span>
          </button>
        </li>
      {{else}}
        <li class="hint">{{localize "WILDPATH.BASTION.MapEmpty"}}</li>
      {{/each}}
    </ol>
    {{#each problems as |problem|}}<p class="wp-warning">{{problem}}</p>{{/each}}
    {{#if editable}}
      <button type="button" data-action="clear">{{localize "WILDPATH.BASTION.MapClear"}}</button>
      <button type="button" data-action="save">{{localize "WILDPATH.BASTION.MapSave"}}</button>
    {{/if}}
    {{#if isGM}}<button type="button" data-action="makeScene">{{localize "WILDPATH.BASTION.MakeScene"}}</button>{{/if}}
  </aside>
  <div class="bastion-grid" style="grid-template-columns: repeat({{size}}, 1fr);" role="grid" aria-label="{{localize "WILDPATH.BASTION.MapTitle" name=""}}">
    {{#each rows as |row|}}{{#each row as |cell|}}<div class="bastion-cell" data-x="{{cell.x}}" data-y="{{cell.y}}" title="{{cell.title}}"
      style="{{#if cell.color}}background: {{cell.color}}{{/if}}"></div>{{/each}}{{/each}}
  </div>
</div>
