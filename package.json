{
  "name": "wildpath",
  "private": true,
  "version": "0.0.1",
  "description": "Wild Path Foundry VTT system. This package.json runs pure rules/domain tests and TypeScript contract checks for staged automation work.",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && tsc -p tsconfig.runtime.json",
    "build:packs": "node scripts/build-packs.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:guide": "node scripts/content/build-guide.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "3.0.4",
    "typescript": "^7.0.2"
  }
}
